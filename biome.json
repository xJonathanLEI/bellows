{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "package.json",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      "biome.json",
      "bellows-ts/**",
      "interop-tests/package.json",
      "interop-tests/tsconfig.json",
      "interop-tests/cloudflare/**/*.ts",
      "bellows/tests/integration/cloudflare/package.json",
      "bellows/tests/integration/cloudflare/tsconfig.json",
      "bellows/tests/integration/cloudflare/*.ts",
      "bellows/tests/integration/cloudflare/*.mjs",
      "bellows/tests/integration/cloudflare/**/wrangler*.jsonc",
      "!**/node_modules",
      "!**/.wrangler",
      "!bellows/tests/integration/cloudflare/**/build",
      "!bellows-ts/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
