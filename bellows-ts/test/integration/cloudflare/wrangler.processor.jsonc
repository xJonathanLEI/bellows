{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "bellows-cloudflare-processor",
  "main": "workers/processor.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BELLOWS_SCHEMA": "bellows_cloudflare"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Local-example-only placeholder. Use a real, caching-disabled Hyperdrive ID to deploy.
      // Locally, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "id": "00000000000000000000000000000000"
    }
  ]
}
